    {
      "parameters": {
        "jsCode": "const statsResponse = $input.first().json;\nconst stats = Array.isArray(statsResponse) ? statsResponse[0] : statsResponse;\nconst campaignId = $('Loop Over Items').first().json.campaign_id;\nconst campaignName = $('Loop Over Items').first().json.campaign_name;\nconst date = $('Loop Over Items').first().json.date;\n\nconst parseAmount = (str) => {\n  if (!str) return 0;\n  return parseFloat(str.replace('USD ', '').trim());\n};\n\nreturn [{\n  json: {\n    date: date,\n    platform: 'nextdoor',\n    campaign_id: campaignId,\n    campaign_name: campaignName,\n    spend: parseAmount(stats.billable_spend),\n    impressions: stats.impressions || 0,\n    clicks: stats.clicks || 0,\n    conversions: stats.total_conversions || 0,\n    ctr: stats.ctr || 0,\n    cpc: parseAmount(stats.cpc),\n    cpm: parseAmount(stats.cpm),\n    account_id: 'NEXTDOOR_ADVERTISER_ID',\n    account_name: 'client ad account',\n    inserted_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
