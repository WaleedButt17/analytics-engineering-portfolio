    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "projectId": {
          "__rl": true,
          "value": "YOUR_GCP_PROJECT_ID",
          "mode": "id"
        },
        "sqlQuery": "SELECT adset_id, adset_name, campaign_id, platform FROM ( SELECT CAST(r.adset_id AS STRING) AS adset_id, r.adset_name, CAST(r.campaign_id AS STRING) AS campaign_id, r.platform, ROW_NUMBER() OVER (PARTITION BY CAST(r.adset_id AS STRING) ORDER BY r.date DESC) AS rn FROM `YOUR_GCP_PROJECT_ID`.staging.v_raw_spend r WHERE r.platform = 'meta' AND r.adset_id IS NOT NULL AND r.date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) ) WHERE rn = 1 ORDER BY campaign_id, adset_name",
        "options": {}
      },
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
        -896,
        96
      ],
      "id": "e481ac05-7fdf-48f9-bb8f-94fb2dd8e12b",
      "name": "Get adsets from BigQuery",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleApi": {
          "id": "GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID",
          "name": "Google service account"
        }
      }
    },
    {
      "parameters": {
