      "position": [
        240,
        0
      ],
      "id": "4254e00c-53fc-418a-af5e-66804b6609b9",
      "name": "Fetch Exchange Rates"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst yesterday = new Date(now);\nyesterday.setDate(yesterday.getDate() - 1);\nconst date = yesterday.toISOString().split('T')[0];\nconst ingested_at = now.toISOString();\n\nconst data = $input.first().json;\nconst rates = data.rates;\n\nconst rows = [];\n\nfor (const [currency, rate] of Object.entries(rates)) {\n  rows.push({\n    json: {\n      date,\n      from_currency: currency,\n      to_currency: 'USD',\n      rate: 1 / rate,\n      ingested_at\n    }\n  });\n}\n\nrows.push({\n  json: {\n    date,\n    from_currency: 'USD',\n    to_currency: 'USD',\n    rate: 1.0,\n    ingested_at\n  }\n});\n\nreturn rows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "8e334c1c-7b14-4504-8f6a-6ef29808d8dc",
      "name": "Transform Rates"
    },
