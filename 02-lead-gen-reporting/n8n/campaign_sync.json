    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "projectId": {
          "__rl": true,
          "value": "YOUR_GCP_PROJECT_ID",
          "mode": "id"
        },
        "sqlQuery": "SELECT campaign_id, campaign_name, platform FROM ( SELECT CAST(campaign_id AS STRING) AS campaign_id, campaign_name, platform, ROW_NUMBER() OVER (PARTITION BY CAST(campaign_id AS STRING) ORDER BY date DESC) AS rn FROM `YOUR_GCP_PROJECT_ID`.staging.v_raw_spend WHERE date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) AND campaign_id IS NOT NULL ) WHERE rn = 1 ORDER BY platform, campaign_name",
        "options": {}
      },
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
        64,
        32
      ],
      "id": "9945895b-6a68-4551-ac58-0dfbddda3779",
      "name": "Execute a SQL query",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleApi": {
          "id": "GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID",
          "name": "Google service account"
        }
      }
    },
