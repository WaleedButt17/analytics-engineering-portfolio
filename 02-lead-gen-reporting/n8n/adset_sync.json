        96
      ],
      "id": "fca597ed-fa1a-4fc2-8a51-3ae6261a0d54",
      "name": "Get rows from Adset Sync",
      "executeOnce": true,
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleApi": {
          "id": "GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID",
          "name": "Google service account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const bqAdsets = $('Get adsets from BigQuery').all().map(item => ({\n  adset_id: String(item.json.adset_id),\n  adset_name: item.json.adset_name,\n  campaign_id: String(item.json.campaign_id),\n  platform: item.json.platform\n}));\n\nconst sheetAdsets = $('Get rows from Adset Sync').all().map(item => ({\n  row_number: item.json.row_number,\n  adset_id: String(item.json.adset_id),\n  adset_name: item.json.adset_name,\n  campaign_id: String(item.json.campaign_id)\n}));\n\nconst sheetMap = {};\nfor (const row of sheetAdsets) {\n  sheetMap[row.adset_id] = row;\n}\n\nconst seen = {};\nconst toAdd = [];\nconst toUpdate = [];\n\nfor (const bq of bqAdsets) {\n  if (seen[bq.adset_id]) continue;\n  seen[bq.adset_id] = true;\n\n  const existing = sheetMap[bq.adset_id];\n\n  if (!existing) {\n    toAdd.push({ json: {\n      adset_id: bq.adset_id,\n      adset_name: bq.adset_name,\n      campaign_id: bq.campaign_id,\n      platform: bq.platform,\n      action: 'add'\n    }});\n  } else if (existing.adset_name !== bq.adset_name) {\n    toUpdate.push({ json: {\n      adset_id: bq.adset_id,\n      adset_name: bq.adset_name,\n      campaign_id: bq.campaign_id,\n      platform: bq.platform,\n      row_number: existing.row_number,\n      action: 'update'\n    }});\n  }\n}\n\nreturn [...toAdd, ...toUpdate];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
