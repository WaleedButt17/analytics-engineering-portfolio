      "id": "1813d97b-7fe7-4551-b7b1-36c731d5d89a",
      "name": "Read SyncWith Meta Ads Sheet",
      "credentials": {
        "googleApi": {
          "id": "GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID",
          "name": "Google service account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const r = item.json;\n\n  if (!r['Day'] || r['Amount spent'] === undefined || r['Amount spent'] === '') continue;\n\n  const spend = parseFloat(r['Amount spent']) || 0;\n  const impressions = parseInt(r['Impressions']) || 0;\n  const link_clicks = parseInt(r['Link clicks']) || 0;\n  const unique_outbound_clicks = parseInt(r['Unique outbound clicks']) || 0;\n  const landing_page_views = parseInt(r['Landing page views']) || 0;\n  const reach = parseInt(r['Reach']) || 0;\n\n  results.push({\n    json: {\n      ingested_at: new Date().toISOString(),\n      source: 'syncwith_meta_ads',\n      date: r['Day'],\n      account_id: String(r['Account ID'] || ''),\n      account_name: r['Account name'] || '',\n      campaign_id: String(r['Campaign ID'] || ''),\n      campaign_name: r['Campaign name'] || '',\n      region: r['Region'] || '',\n      country: r['Country'] || 'ALL',\n      impressions,\n      reach,\n      frequency: reach > 0 ? parseFloat((impressions / reach).toFixed(4)) : 0,\n      spend,\n      link_clicks,\n      unique_outbound_clicks,\n      ctr: impressions > 0 ? parseFloat((link_clicks / impressions).toFixed(6)) : 0,\n      cpc: link_clicks > 0 ? parseFloat((spend / link_clicks).toFixed(4)) : 0,\n      cpm: impressions > 0 ? parseFloat((spend / impressions * 1000).toFixed(4)) : 0,\n      landing_page_views,\n      cost_per_landing_page_view: landing_page_views > 0 ? parseFloat((spend / landing_page_views).toFixed(4)) : 0,\n      click_to_lpv_dropoff_pct: unique_outbound_clicks > 0\n        ? parseFloat(((unique_outbound_clicks - landing_page_views) / unique_outbound_clicks).toFixed(6))\n        : 0,\n    }\n  });\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "22387439-4bc0-4907-b536-1b13fd54381b",
