      "id": "1357de1c-9892-4fb9-bd54-bc664aad42f8",
      "name": "Get row(s) in sheet",
      "executeOnce": true,
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleApi": {
          "id": "GOOGLE_SERVICE_ACCOUNT_CREDENTIAL_ID",
          "name": "Google service account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const bqCampaigns = $('Execute a SQL query').all().map(item => ({\n  campaign_id: String(item.json.campaign_id),\n  campaign_name: item.json.campaign_name,\n  platform: item.json.platform\n}));\n\nconst sheetCampaigns = $('Get row(s) in sheet').all().map(item => ({\n  row_number: item.json.row_number,\n  campaign_id: String(item.json.campaign_id),\n  campaign_name: item.json.campaign_name,\n  platform: item.json.platform\n}));\n\nconst sheetMap = {};\nfor (const row of sheetCampaigns) {\n  sheetMap[row.campaign_id] = row;\n}\n\nconst toAdd = [];\nconst toUpdate = [];\n\nfor (const bq of bqCampaigns) {\n  const existing = sheetMap[bq.campaign_id];\n  if (!existing) {\n    toAdd.push({ json: { campaign_id: bq.campaign_id, campaign_name: bq.campaign_name, platform: bq.platform, action: 'add' }});\n  } else if (existing.campaign_name !== bq.campaign_name) {\n    toUpdate.push({ json: { campaign_id: bq.campaign_id, campaign_name: bq.campaign_name, platform: bq.platform, row_number: existing.row_number, action: 'update' }});\n  }\n}\n\nreturn [...toAdd, ...toUpdate];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
